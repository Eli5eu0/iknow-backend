#!/bin/sh
# Bloqueia commits que incluam credenciais em colecções Insomnia ou JWT em ficheiros de texto.
# Activar uma vez por clone: git config core.hooksPath .githooks
# Contornar (só se for um falso positivo confirmado): git commit --no-verify

root="$(cd "$(dirname "$0")/.." && pwd)"

for candidate in "$root/.venv/Scripts/python.exe" "$root/.venv/bin/python" python3 python py; do
    if command -v "$candidate" >/dev/null 2>&1 || [ -x "$candidate" ]; then
        exec "$candidate" "$root/scripts/check_collections.py" --staged
    fi
done

echo "pre-commit: Python não encontrado; a verificação de credenciais não foi executada." >&2
exit 1
