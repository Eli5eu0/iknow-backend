APP_NAME=iKnow API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# PostgreSQL local (docker-compose.yml)
POSTGRES_DB=iknow
POSTGRES_USER=iknow
POSTGRES_PASSWORD=iknow_local_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://iknow:iknow_local_dev@localhost:5432/iknow

CORS_ORIGINS=http://localhost:5173
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
