APP_NAME=iKnow API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# PostgreSQL local (docker-compose.yml)
# Replace the placeholder with a unique local password in your untracked .env file.
POSTGRES_DB=iknow
POSTGRES_USER=iknow
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_UNIQUE_PASSWORD
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://iknow:CHANGE_ME_WITH_A_UNIQUE_PASSWORD@localhost:5432/iknow

# Frontend origins, comma-separated and explicit (never use * with credentials)
CORS_ORIGINS=http://localhost:5173

# Replace this placeholder with a cryptographically random secret (at least 32 characters).
JWT_SECRET_KEY=CHANGE_ME_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Local HTTP development. Set AUTH_COOKIE_SECURE=true behind HTTPS in production.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_DOMAIN=example.com
